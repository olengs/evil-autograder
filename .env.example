# Copy this file to ".env" and fill in your own API key.
# The real ".env" is git-ignored and must NEVER be committed or shared.
#
# The variable name must match "llm.api.key.env" in config.properties.
# Set ONE key matching the provider you configured there.

# Default: Google Gemini free tier (llm.provider=gemini)
LLM_API_KEY=your-gemini-api-key-here

# Example: Groq free tier (llm.provider=openai-compatible, base url https://api.groq.com/openai/v1)
# LLM_API_KEY=your-groq-api-key-here

# Example: official OpenAI (llm.provider=openai-compatible, base url https://api.openai.com/v1)
# LLM_API_KEY=your-openai-api-key-here
