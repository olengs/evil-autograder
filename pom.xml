<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>cs102-g2-t5</groupId>
    <artifactId>evil-autograder</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- default main class for exec:java > override with -Dexec.mainClass=generation.TesterGeneratorApp-->
        <exec.mainClass>app.Main</exec.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
        </dependency>
        <dependency>
            <groupId>com.opencsv</groupId>
            <artifactId>opencsv</artifactId>
            <version>5.12.0</version>
        </dependency>
        <dependency>
            <!-- read the api key from a git-ignored .env file > host env vars take precedence-->
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>3.2.0</version>
        </dependency>
        <dependency>
            <!-- official openai sdk > talks to openai & any openai-compatible endpoint (groq / openrouter / ollama)-->
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <version>4.85.0</version>
        </dependency>
        <dependency>
            <!-- official google gen ai sdk > gemini generateContent with native pdf input-->
            <groupId>com.google.genai</groupId>
            <artifactId>google-genai</artifactId>
            <version>1.78.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.4</version>
            <scope>test</scope> <!--@1ejun6 > make junit available only to test code-->
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <!-- default main is the grader > override on the cli with -Dexec.mainClass=... (e.g. the generator)-->
                <configuration><mainClass>${exec.mainClass}</mainClass></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId> <!--@1ejun6 > connects maven to junit so mvn test actually runs your tests-->
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <!--@1ejun6 > keep terminal input available for project folder prompt-->
                    <forkCount>0</forkCount>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
